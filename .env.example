conda_name=

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-run-manage.py-generate_secret_key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when running behind https, e.g. https://app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC

# --- Which login methods are enabled --------------------------------------
AUTH_ENABLE_OIDC=true
# Local Django passwords, so a createsuperuser account can still reach /admin/
# if the provider is unreachable. Set false to make SSO the only way in.
AUTH_ENABLE_LOCAL_PASSWORDS=true

# --- OpenID Connect provider (Authentik) ----------------------------------
# Issuer as shown on the provider page in Authentik. The authorize, token,
# userinfo, JWKS and end-session endpoints are derived from it; override any
# of them below if your provider differs (`manage.py oidc_discover` prints the
# provider's own values).
OIDC_ISSUER=https://authentik.example.com/application/o/django-sso-template/
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=

# OIDC_OP_AUTHORIZATION_ENDPOINT=
# OIDC_OP_TOKEN_ENDPOINT=
# OIDC_OP_USER_ENDPOINT=
# OIDC_OP_JWKS_ENDPOINT=
# OIDC_OP_LOGOUT_ENDPOINT=

# Add "groups" if you have configured a groups scope mapping in Authentik and
# want group sync (see README).
OIDC_RP_SCOPES=openid email profile
OIDC_RP_SIGN_ALGO=RS256
OIDC_USE_PKCE=true

# --- Account behaviour ----------------------------------------------------
# Create a Django user on first login. Set false to allow only pre-created users.
OIDC_CREATE_USER=true
# Mirror the provider's group claim onto Django groups on every login.
OIDC_SYNC_GROUPS=true
OIDC_GROUPS_CLAIM=groups
OIDC_USERNAME_CLAIM=preferred_username
# Provider group whose members get Django staff / superuser rights. Leave blank
# to manage those flags in Django instead.
OIDC_STAFF_GROUP=
OIDC_SUPERUSER_GROUP=
# Re-validate the session against the provider after this many seconds.
OIDC_RENEW_SESSION=true
OIDC_RENEW_ID_TOKEN_EXPIRY_SECONDS=900
# Set to DEBUG while troubleshooting a login.
OIDC_LOG_LEVEL=INFO

# --- Where to land after login/logout -------------------------------------
LOGIN_REDIRECT_URL=/profile/
LOGOUT_REDIRECT_URL=/
LOGIN_REDIRECT_URL_FAILURE=/

# --- LDAP directory (optional) --------------------------------------------
# Off by default. Needs `pip install -r requirements-ldap.txt`.
# Full walkthrough, including JumpCloud: docs/ldap.md
AUTH_ENABLE_LDAP=false

# Use ldaps:// on 636, or ldap:// on 389 with LDAP_START_TLS=true. Never plain
# ldap:// without START_TLS: every password crosses the network in the clear.
LDAP_SERVER_URI=ldaps://ldap.jumpcloud.com:636
LDAP_START_TLS=false

# Service account used to look users up before their own bind. Leave both blank
# to search anonymously, if your directory allows it.
LDAP_BIND_DN=uid=ldapservice,ou=Users,o=YOUR_ORG_ID,dc=jumpcloud,dc=com
LDAP_BIND_PASSWORD=

# Where people live, and how to find one by the name they type at login.
LDAP_USER_SEARCH_BASE=ou=Users,o=YOUR_ORG_ID,dc=jumpcloud,dc=com
LDAP_USER_SEARCH_SCOPE=subtree
LDAP_USER_SEARCH_FILTER=(&(objectClass=inetOrgPerson)(uid=%(user)s))

# Directory attribute -> Django user field.
LDAP_USER_ATTR_MAP=first_name=givenName,last_name=sn,email=mail
LDAP_ALWAYS_UPDATE_USER=true

# Groups. Leave the base blank to skip group lookups entirely. On JumpCloud,
# groups sit in the same ou=Users as people.
LDAP_GROUP_SEARCH_BASE=ou=Users,o=YOUR_ORG_ID,dc=jumpcloud,dc=com
LDAP_GROUP_SEARCH_SCOPE=subtree
# groupOfNames | nestedGroupOfNames | groupOfUniqueNames |
# nestedGroupOfUniqueNames | posixGroup | organizationalRole |
# nestedOrganizationalRole | activeDirectory | nestedActiveDirectory
LDAP_GROUP_TYPE=groupOfNames
# Defaults to (objectClass=<the type above>); set for a narrower filter.
LDAP_GROUP_SEARCH_FILTER=

# Copy directory groups onto the Django user at every login.
LDAP_MIRROR_GROUPS=true
# Or mirror only these, leaving every other Django group managed locally.
LDAP_MIRROR_GROUPS_ONLY=

# Access rules. These match on the full group DN, not the group name.
LDAP_REQUIRE_GROUP=
LDAP_DENY_GROUP=
LDAP_STAFF_GROUP=
LDAP_SUPERUSER_GROUP=

# Let Django permissions come from directory groups. Off by default: it makes
# every permission check consult the group tree.
LDAP_FIND_GROUP_PERMS=false

LDAP_CONNECTION_TIMEOUT=10
LDAP_TLS_VERIFY=true
LDAP_CA_CERT_FILE=
# Seconds to cache the user lookup and group membership. 0 disables caching.
LDAP_CACHE_TIMEOUT=3600
# Set to DEBUG to have django-auth-ldap say why a login was refused.
LDAP_LOG_LEVEL=WARNING
